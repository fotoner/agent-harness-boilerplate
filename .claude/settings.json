{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "# 점진적 하네스: 같은 실수가 2회 반복되면 여기에 검사를 추가한다 (CLAUDE.md \"점진적 하네스\")\nexit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/worklog_capture.py\" --harness claude --nudge",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/worklog_capture.py\" --harness claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
